# StaleBot configuration — copy to .env and fill in. Never commit the real .env.
# Note: values in .env override variables already set in the environment.

# ---------------------------------------------------------------------------
# Required: live search + at least one model route (Bifrost gateway and/or GROQ_API_KEY)
# On Streamlit Community Cloud, put these in the app's Settings → Secrets as KEY = "value".
# ---------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-key
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_VIRTUAL_KEY=your-bifrost-virtual-key
MODEL_NAME=groq/openai/gpt-oss-20b

# Fallback when the Bifrost gateway is down or unreachable (e.g. on Streamlit Cloud, where a
# localhost/private gateway URL can't be reached): StaleBot calls Groq directly.
# Get a key at https://console.groq.com. Set only GROQ_API_KEY to use Groq without Bifrost at all.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b     # default: the groq/... part of MODEL_NAME, else llama-3.3-70b-versatile

# Optional: footer credits in the Streamlit app
# STALEBOT_AUTHOR=Your Name
# STALEBOT_GITHUB_URL=https://github.com/you/stalebot

# Optional: models offered in the dashboard dropdown ("provider/model:Label", comma-separated).
# AVAILABLE_MODELS=groq/openai/gpt-oss-20b:GPT OSS 20B,openai/gpt-4o:GPT-4o

# ---------------------------------------------------------------------------
# Security — set these before anyone else can reach the app
# ---------------------------------------------------------------------------
# "production" turns on: admin key required for admin actions, API docs off, HSTS header.
# Leave as "development" for local use (everyone is admin, no keys needed).
APP_ENV=development

# Admin key: delete history, switch models, manage projects. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Access key: if set, visitors must enter it before using the app (private deployment).
# Leave empty for a public app (visitors can then read the shared history and run analyses).
ACCESS_TOKEN=

# Network
HOST=127.0.0.1          # use 0.0.0.0 inside a container / behind a reverse proxy
PORT=8000
TRUST_PROXY=false       # true only behind your own reverse proxy (reads X-Forwarded-For)
ENABLE_API_DOCS=        # empty = on in development, off in production

# Cost and abuse limits (per visitor IP unless noted; admins are exempt from analyze limits)
ANALYZE_LIMIT_PER_MINUTE=3
ANALYZE_LIMIT_PER_HOUR=30
MAX_CONCURRENT_ANALYSES=3     # server-wide
MAX_CLAIMS_PER_REQUEST=8      # each claim = 1 live search + 1 model call (max 25)
API_RATE_LIMIT_PER_MINUTE=120
PROBE_COOLDOWN_SECONDS=60     # gateway re-checks (paid) for non-admins
MAX_REQUEST_BYTES=65536

# Storage (point at a persistent volume in production; the Docker image uses /data)
# DATA_DIR=/var/lib/stalebot

# Docker Compose only: gateway address as seen from inside the container
# ("localhost" there means the container itself).
# BIFROST_BASE_URL_DOCKER=http://host.docker.internal:8080/v1
