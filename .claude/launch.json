{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stalebot",
      "runtimeExecutable": "python",
      "runtimeArgs": ["server.py"],
      "port": 8000
    },
    {
      "name": "streamlit",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.headless", "true", "--server.address", "localhost", "--server.port", "8501"],
      "port": 8501
    },
    {
      "name": "streamlit-dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "streamlit", "run", "streamlit_dashboard.py", "--server.headless", "true", "--server.address", "localhost", "--server.port", "8502"],
      "port": 8502
    }
  ]
}
